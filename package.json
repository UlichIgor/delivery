{
  "name": "delivery",
  "version": "0.1.0",
  "private": true,
  "keywords": [],
  "author": "Ulich Igor",
  "license": "ISC",
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "10.4.5",
    "bootstrap": "^5.2.3",
    "core-js": "^3.33.3",
    "env-cmd": "^10.1.0",
    "lint-staged": "^13.2.2",
    "loader": "^2.1.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.4",
    "react-dom": "^18.2.0",
    "react-icons": "^4.9.0",
    "react-router-dom": "^5.3.4",
    "react-sass-inlinesvg": "^1.0.5",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.1",
    "stylelint-scss": "^5.3.1",
    "svg-url-loader": "^8.0.0",
    "unused-files-webpack-plugin": "^3.4.0",
    "webpack-merge": "^5.9.0"
  },
  "scripts": {
    "start": "react-scripts start -l 3000 && webpack --mode development",
    "build": "react-scripts build && webpack --progress --mode production",
    "deploy": "serve -s build -l 4000"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "development": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version"
  ],
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-template-literals": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@gerhobbelt/babel-plugin-proposal-class-properties": "^7.2.1-26",
    "@svgr/webpack": "^8.1.0",
    "@types/react-router-dom": "^5.3.3",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "file-loader": "^6.2.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.3",
    "image-webpack-loader": "^8.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "raw-loader": "^4.0.2",
    "sass": "^1.64.2",
    "sass-loader": "^13.3.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-react-native": "^2.6.0",
    "stylelint-webpack-plugin": "^4.1.1",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.4.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  },
  "compilerOptions": {
    "jsx": "react",
    "sourceMap": true
  },
  "env": {
    "react-native/react-native": true
  },
  "extends": [
    "plugin:react-native/all"
  ],
  "plugins": [
    "stylelint-scss",
    "stylelint-react-native",
    "react-native"
  ],
  "rules": {
    "react-native/no-unused-styles": 2,
    "react-native/split-platform-components": 2,
    "react-native/no-inline-styles": 2,
    "react-native/no-color-literals": 2,
    "react-native/no-raw-text": 2,
    "react-native/no-single-element-style-arrays": 2,
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": false
      }
    ]
  }
}
